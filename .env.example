# ============================================================
# TenderIQ — environment template. Copy to .env.local and fill.
# .env.local and gcp-key.json are gitignored. NEVER commit secrets.
# ============================================================

# ---- Google Cloud / Vertex AI (used by /api) ----
# Path to the service-account JSON key (kept at repo root, gitignored).
GOOGLE_APPLICATION_CREDENTIALS=./gcp-key.json
GCP_PROJECT_ID=bids-497610
GCP_LOCATION=asia-south1
GEMINI_PRO_MODEL=gemini-2.5-pro
GEMINI_FLASH_MODEL=gemini-2.5-flash
# 2.5 Pro is not available in asia-south1 — route Pro calls to global (or us-central1).
GEMINI_PRO_LOCATION=global

# ---- Supabase (Mumbai project) ----
# Server-side (/api): full URL + service role key (NEVER expose to client).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Client-side (/web): public URL + anon key (safe to expose; RLS enforces access).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Frontend -> backend wiring (/web) ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---- Backend (/api) runtime ----
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated origins allowed by FastAPI CORS.
CORS_ORIGINS=http://localhost:3000
